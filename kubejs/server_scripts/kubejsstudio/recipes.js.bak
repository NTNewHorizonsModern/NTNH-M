// kubejsstudio recipes; re-apply merges by recipe id
ServerEvents.generateData('after_mods', event => {
    event.json('minecraft:recipe/wooden_pickaxe', {"type":"minecraft:crafting_shaped","category":"equipment","pattern":["##","A "],"key":{"#":{"item":"minecraft:flint"},"A":{"item":"minecraft:stick"}},"result":{"id":"minecraft:wooden_pickaxe","count":1}})
