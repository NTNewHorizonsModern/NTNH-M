ServerEvents.recipes(event => {
    event.remove({ id: 'kubejsstudio:printed_conc_proc' })
    event.remove({ id: 'minecraft:wooden_hoe' })
    event.remove({ id: 'minecraft:wooden_sword' })
    event.remove({ id: 'kubejsstudio:eng_proc' })
    event.remove({ id: 'ae2:network/blocks/inscribers' })
    event.remove({ id: 'extendedae:assembler/ex_inscriber' })
    event.remove({ id: 'extendedae:assembler/circuit_cutter' })
    event.shaped('extendedae:vacuum_interface', [' # ', 'ABA', 'A A'], { '#': '#extendedae:extended_interface', 'A': 'ae2:calculation_processor', 'B': 'ae2:spatial_cell_component_2' }).id('kubejsstudio:vacuum_interface')
    event.remove({ id: 'extendedae:vacuum_interface' })
    event.remove({ id: 'extendedae:assembler/fluix_transformation' })
    event.shaped('extendedae:ex_export_bus_part', [' # ', 'ABA', 'CCC'], { '#': 'ae2:formation_core', 'A': 'minecraft:piston', 'B': 'ae2:export_bus', 'C': 'ae2:speed_card' }).id('kubejsstudio:ex_export_bus_part')
    event.shaped('extendedae:smart_annihilation_plane', [' # ', 'ABA', 'CCC'], { '#': 'extendedae:ex_import_bus_part', 'A': 'ae2:annihilation_core', 'B': 'ae2:annihilation_plane', 'C': 'minecraft:piston' }).id('kubejsstudio:smart_annihilation_plane')
    event.shaped('extendedae:ex_import_bus_part', [' # ', 'ABA', 'CCC'], { '#': 'ae2:annihilation_core', 'A': 'minecraft:piston', 'B': 'ae2:import_bus', 'C': 'ae2:speed_card' }).id('kubejsstudio:ex_import_bus_part')
    event.shaped('extendedae:active_formation_plane', [' # ', 'ABA', 'CCC'], { '#': 'extendedae:ex_export_bus_part', 'A': 'ae2:formation_core', 'B': 'ae2:formation_plane', 'C': 'minecraft:piston' }).id('kubejsstudio:active_formation_plane')
    event.shaped('extendedae:crystal_fixer', ['#A#', 'ABA', '#A#'], { '#': 'ae2:certus_quartz_crystal', 'A': 'ae2:quartz_fiber', 'B': 'extendedae:machine_frame' }).id('kubejsstudio:crystal_fixer')
    event.shaped('extendedae:ex_drive', [' # ', 'ABA', ' C '], { '#': 'extendedae:concurrent_processor', 'A': '#ae2:glass_cable', 'B': 'ae2:drive', 'C': 'ae2:capacity_card' }).id('kubejsstudio:ex_drive')
    event.shaped('extendedae:ex_pattern_access_part', ['# #', 'ABA', '#C#'], { '#': 'ae2:quartz_fixture', 'A': 'ae2:logic_processor', 'B': 'ae2:pattern_access_terminal', 'C': 'minecraft:redstone_lamp' }).id('kubejsstudio:ex_pattern_access_part')
    event.remove({ id: 'extendedae:assembler/concurrent_processor' })
    event.remove({ id: 'opencomputers:adapter' })
    event.remove({ id: 'opencomputers:assembler' })
    event.remove({ id: 'opencomputers:capacitor' })
    event.remove({ id: 'opencomputers:case1' })
    event.remove({ id: 'opencomputers:case3' })
    event.remove({ id: 'opencomputers:case4' })
    event.remove({ id: 'opencomputers:case2' })
    event.remove({ id: 'opencomputers:rawcircuitboard' })
    event.shaped('opencomputers:navigationupgrade', ['#', 'A', 'B'], { '#': 'opencomputers:chip1', 'A': 'minecraft:map', 'B': 'hbm:circuit_pcb' }).id('opencomputers:navigationupgrade')
    event.shapeless('opencomputers:screen1', ['opencomputers:frontflatscreen1']).id('kubejsstudio:screen1')
})
